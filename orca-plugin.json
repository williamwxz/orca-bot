{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "bot-for-orca",
  "name": "Bot Team for Orca",
  "version": "0.2.0",
  "description": "Your Hermes Agent bots in Orca’s sidebar: the list of bots on this computer or a paired Orca server, and each one’s chat. Unofficial. Not made by or affiliated with Orca or Nous Research.",
  "license": "Apache-2.0",
  "author": {
    "name": "William Weixin Zhang",
    "url": "https://github.com/williamwxz"
  },
  "repository": "https://github.com/williamwxz/orca-bot",
  "icon": "images/icon.png",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "bots",
        "title": "Bot Team for Orca",
        "icon": "bot",
        "entry": "panel/index.html"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ]
}
